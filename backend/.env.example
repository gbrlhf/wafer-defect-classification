# Application Environment
APP_ENV=development
APP_NAME="Wafer Defect ML API"
DEBUG=true

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8001

# CORS Allowed Origins (comma separated)
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8000,http://localhost

# Model Storage Directory (relative to backend root)
MODELS_DIR=app/models
